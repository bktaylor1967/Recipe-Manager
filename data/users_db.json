        {
          "id": "recipe-tuscan-salmon",
          "title": "Crispy Skin Creamy Tuscan Salmon",
          "description": "Pan-seared Atlantic salmon fillets with shatteringly crisp skin, simmered in a velvety garlic, sun-dried tomato, and baby spinach cream sauce.",
          "author": "Carolina Gelen",
          "sourceUrl": "https://instagram.com/reel/C8x9123TuscanSalmon",
          "sourcePlatform": "instagram",
          "imageUrl": "/src/assets/images/creamy_tuscan_salmon_1794058991512.jpg",
          "servings": 2,
          "prepMinutes": 10,
          "cookMinutes": 18,
          "difficulty": "Easy",
          "cuisine": "Italian",
          "calories": 520,
          "proteinGrams": 42,
          "tags": [
            "High-Protein",
            "Keto",
